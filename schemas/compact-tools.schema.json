{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nedleeds/pi-compact-tools/main/schemas/compact-tools.schema.json",
  "title": "pi-compact-tools configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tools": {
      "description": "Built-in tools that use compact rendering. Omitted tools keep Pi's default renderer.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read", "write", "edit", "bash", "powershell", "grep", "find", "ls"]
      },
      "default": ["read", "write", "edit", "bash"]
    },
    "auto_compact": {
      "description": "Whether each compact-rendered tool starts compact and participates in the global Ctrl+O expand/collapse action. False starts expanded and excludes the tool from that action; clicking remains available.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "type": "boolean", "default": true },
        "write": { "type": "boolean", "default": true },
        "edit": { "type": "boolean", "default": false },
        "bash": { "type": "boolean", "default": true },
        "powershell": { "type": "boolean", "default": true },
        "grep": { "type": "boolean", "default": true },
        "find": { "type": "boolean", "default": true },
        "ls": { "type": "boolean", "default": true }
      },
      "default": {
        "read": true,
        "write": true,
        "edit": false,
        "bash": true
      }
    },
    "spinner": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frames": {
          "description": "Animation frames. Use terminal-safe single-width characters for consistent alignment.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": ["◐", "◓", "◑", "◒"]
        },
        "intervalMs": {
          "description": "Milliseconds between spinner frames.",
          "type": "integer",
          "minimum": 40,
          "maximum": 5000,
          "default": 120
        }
      }
    }
  }
}
