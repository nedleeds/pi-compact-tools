{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nedleeds/pi-compact-tools/main/schemas/compact-tools.schema.json",
  "title": "pi-compact-tools configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "tools": {
      "description": "Built-in tools that use compact rendering. Omitted tools keep Pi's default renderer.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": ["read", "write", "edit", "bash", "powershell", "grep", "find", "ls"]
      },
      "default": ["read", "write", "edit", "bash"]
    },
    "previewLines": {
      "description": "Maximum rendered lines shown initially when auto_compact is false. Explicit expansion always shows the complete result.",
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 10
    },
    "auto_compact": {
      "description": "Whether each compact-rendered tool starts hidden. False starts with a bounded preview; Pi's normal click and Ctrl+O flow can expand either state.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "read": { "type": "boolean", "default": true },
        "write": { "type": "boolean", "default": true },
        "edit": { "type": "boolean", "default": false },
        "bash": { "type": "boolean", "default": true },
        "powershell": { "type": "boolean", "default": true },
        "grep": { "type": "boolean", "default": true },
        "find": { "type": "boolean", "default": true },
        "ls": { "type": "boolean", "default": true }
      },
      "default": {
        "read": true,
        "write": true,
        "edit": false,
        "bash": true
      }
    }
  }
}
